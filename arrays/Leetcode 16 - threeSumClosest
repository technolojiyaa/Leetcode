class Solution {
public:
    int threeSumClosest(vector<int>& nums, int target) {

        sort(nums.begin(), nums.end());
        int n = nums.size();
        int nearest = (nums[0]+ nums[1]+ nums[2]);

        for(int i=0; i<n; i++){
            if (i>0 && nums[i]==nums[i-1])continue;

            int j = i+1;
            int k = n-1;

            while(j<k){
                int sum = nums[i]+nums[j]+ nums[k];
                // nearest = min((target-sum),nearest); cant use this, since we want absolute value

                if(abs(target-sum)<abs(target-nearest)){
                    nearest = sum;
                }


                if(sum < target) {
                    j++;
                }
                else if(sum > target) {
                    k--;
                }
                else {
                    return sum;
                }
            }
        }

        return nearest;
    }
};
        
 
