/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    void deleteNode(ListNode* node) {

        ListNode* temp = node;
        ListNode* value = node;
        ListNode* prev = node;

        while(temp->next!=NULL){

            value = temp->next;
            prev = temp;
            temp->val = value->val;
            temp = temp->next;
            

        }
        
        prev->next = NULL;
        delete temp;
    }
};


